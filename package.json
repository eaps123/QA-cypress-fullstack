{
  "name": "qa-automation-cypress",
  "version": "1.0.0",
  "description": "QA Automation project using Cypress, Cucumber, API testing and K6 performance testing",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "cypress run --spec 'e2e/features/**/*.feature'",
    "test:api": "cypress run --spec 'api/tests/**/*.cy.ts'",
    "test:full": "npm run test:api && npm run test:e2e",
    "test:performance": "k6 run performance/load-test.js",
    "report": "node scripts/generate-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^25.6.0",
    "cucumber-html-reporter": "^7.2.0",
    "cypress": "^15.14.2",
    "cypress-mochawesome-reporter": "^4.0.2",
    "esbuild": "^0.28.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
